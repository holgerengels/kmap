# ── Stage 0: Build Frontend SPA ─────────────────────────────────────
# Must stay identical to the builder stage in frontend.docker: BuildKit then reuses the cached layers, so the
# index.html served by IndexServlet references exactly the same hashed bundle as the one served by kmap-frontend.
FROM node:20-alpine AS client
WORKDIR /app

COPY client/package*.json ./
RUN npm ci || npm install

COPY client/ ./
RUN npm run build

# ── Stage 1: Build Java WAR with Maven ──────────────────────────────
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

# Copy server sources (configuration is NOT part of the image, it is mounted at runtime as /config)
COPY server/pom.xml /build/server/
COPY server/src /build/server/src

# IndexServlet serves the BUILT index.html for deep links (/app/browser/... -> /server/index/...)
COPY --from=client /app/dist/index.html /build/server/src/main/webapp/index.html

WORKDIR /build/server
RUN mvn clean package -DskipTests

# ── Stage 2: Jetty 11 Runtime ──────────────────────────────────────
FROM jetty:11-jre21-alpine

# Copy server.war into Jetty's webapps directory
COPY --from=builder /build/server/target/server.war /var/lib/jetty/webapps/server.war

USER jetty
EXPOSE 8080
