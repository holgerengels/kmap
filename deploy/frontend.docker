# ── Stage 1: Build Frontend SPA ─────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY client/package*.json ./
RUN npm ci || npm install

COPY client/ ./
RUN npm run build

# ── Stage 2: Nginx Webserver ────────────────────────────────────────
FROM nginx:alpine

# Copy built frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html/app
RUN cp -r /usr/share/nginx/html/app/* /usr/share/nginx/html/

# Copy Nginx server configuration
COPY prod/nginx/conf/kmap.conf /etc/nginx/conf.d/default.conf

# Generate fallback self-signed SSL certs so nginx starts even if no volume is mounted yet
RUN mkdir -p /etc/nginx/ssl && \
    apk add --no-cache openssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout /etc/nginx/ssl/www.kmap.eu.key \
        -out /etc/nginx/ssl/www.kmap.eu.crt \
        -subj "/CN=kmap.eu" && \
    apk del openssl

EXPOSE 80 443
